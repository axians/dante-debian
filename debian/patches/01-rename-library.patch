Description: Rename the libdsocks library to avoid a conflict with libsocks4.
Bug-Debian: http://bugs.debian.org/52476
Forwarded: not-needed
Author: Adrian Bridgett <bridgett@debian.org>
Last-Update: 2010-07-01

--- a/bin/socksify.in
+++ b/bin/socksify.in
@@ -52,7 +52,7 @@
 LIBDIR="@LIBRARY_PREFIX@"
 
 #dlib/Makefile.am libtool flags should produce a predictable library name
-LIBRARY="${SOCKS_LIBRARY-${LIBDIR}/libdsocks.@SOLIB_POSTFIX@}"
+LIBRARY="${SOCKS_LIBRARY-${LIBDIR}/libdsocksd.@SOLIB_POSTFIX@}"
 
 if ! test -s "$LIBRARY"; then
     echo "socksify: missing $LIBRARY. no preload support?" >&2
