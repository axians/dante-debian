From: Peter Pentchev <roam@ringlet.net>
Date: Tue, 25 Jul 2023 14:56:23 +0300
Subject: Only use SA_SIGINFO if available (e.g. not on GNU/Hurd)

Forwarded: no
Last-Update: 2016-04-05
---
 lib/connectchild.c      | 12 ++++++++++++
 lib/upnp.c              |  2 ++
 sockd/monitor.c         |  4 ++++
 sockd/mother_util.c     |  6 ++++++
 sockd/sockd.c           |  4 ++++
 sockd/sockd_child.c     |  4 ++++
 sockd/sockd_io.c        |  4 ++++
 sockd/sockd_negotiate.c |  4 ++++
 sockd/sockd_request.c   |  4 ++++
 9 files changed, 44 insertions(+)

diff --git a/lib/connectchild.c b/lib/connectchild.c
index 863b2c5..a653745 100644
--- a/lib/connectchild.c
+++ b/lib/connectchild.c
@@ -132,6 +132,7 @@ socks_nbconnectroute(s, control, packet, src, dst, emsg, emsglen)
       return NULL;
    }
 
+#ifdef SA_SIGINFO
    if (currentsig.sa_flags & SA_SIGINFO) { /* sa_sigaction. */
       isourhandler = (currentsig.sa_sigaction == sigio);
 
@@ -149,6 +150,7 @@ socks_nbconnectroute(s, control, packet, src, dst, emsg, emsglen)
       }
    }
    else { /* sa_handler. */
+#endif
       isourhandler = 0; /* we install with SA_SIGINFO. */
 
       if (currentsig.sa_handler != SIG_IGN
@@ -702,7 +704,9 @@ install_sigio(emsg, emsglen)
 
    newsig               = currenthandler; /* keep same as much as possible. */
    newsig.sa_sigaction  = sigio;
+#ifdef SA_SIGINFO
    newsig.sa_flags     |= SA_SIGINFO;
+#endif
 
    originalhandler      = currenthandler;
 
@@ -728,6 +732,7 @@ our_sigio_is_installed(void)
       return 0;
    }
 
+#ifdef SA_SIGINFO
    if (currenthandler.sa_flags & SA_SIGINFO) { /* sa_sigaction. */
       if (currenthandler.sa_sigaction == sigio) {
          slog(LOG_DEBUG, "%s: our SIGIO-handler is installed", function);
@@ -752,6 +757,7 @@ our_sigio_is_installed(void)
       }
    }
    else { /* we use sa_sigaction, so this is for sure not our handler. */
+#endif
       if (currenthandler.sa_handler != SIG_IGN
       &&  currenthandler.sa_handler != SIG_DFL) 
          slog(LOG_DEBUG,
@@ -761,7 +767,9 @@ our_sigio_is_installed(void)
          slog(LOG_DEBUG, "%s: no SIGIO-handler installed", function);
 
       return 0;
+#ifdef SA_SIGINFO
    }
+#endif
 }
 
 
@@ -1385,6 +1393,7 @@ sigio(sig, sip, scp)
       return;
    }
 
+#ifdef SA_SIGINFO
    if (originalhandler.sa_flags & SA_SIGINFO
    &&  originalhandler.sa_sigaction != NULL) {
       const char *msgv[] =
@@ -1399,6 +1408,7 @@ sigio(sig, sip, scp)
       originalhandler.sa_sigaction(sig, sip, scp);
    }
    else {
+#endif
       if (originalhandler.sa_handler != SIG_IGN
       &&  originalhandler.sa_handler != SIG_DFL) {
          const char *msgv[] =
@@ -1412,7 +1422,9 @@ sigio(sig, sip, scp)
 
          originalhandler.sa_handler(sig);
       }
+#ifdef SA_SIGINFO
    }
+#endif
 
    if (sockscf.connectchild == 0) {
       sockscf.state.insignal = 0;
diff --git a/lib/upnp.c b/lib/upnp.c
index 92be673..1325f79 100644
--- a/lib/upnp.c
+++ b/lib/upnp.c
@@ -820,7 +820,9 @@ upnp_negotiate(s, packet, gw, emsg, emsglen)
 
                oursig = oldsig;
                oursig.sa_handler = sighandler;
+#ifdef SA_SIGINFO
                oursig.sa_flags  |= SA_SIGINFO;
+#endif
 
                if (sigaction(signalv[i], &oursig, NULL) != 0) {
                   swarn("%s: sigaction(%d)", function, signalv[i]);
diff --git a/sockd/monitor.c b/sockd/monitor.c
index 5264432..444ad61 100755
--- a/sockd/monitor.c
+++ b/sockd/monitor.c
@@ -408,7 +408,11 @@ run_monitor(void)
    fd_set *rset;
 
    bzero(&sigact, sizeof(sigact));
+#ifdef SA_SIGINFO
    sigact.sa_flags     = SA_RESTART | SA_SIGINFO;
+#else
+   sigact.sa_flags     = SA_RESTART;
+#endif
    sigact.sa_sigaction = siginfo;
 
 #if HAVE_SIGNAL_SIGINFO
diff --git a/sockd/mother_util.c b/sockd/mother_util.c
index a504262..c3bb5d6 100755
--- a/sockd/mother_util.c
+++ b/sockd/mother_util.c
@@ -262,7 +262,11 @@ mother_envsetup(argc, argv)
     */
 
    bzero(&sigact, sizeof(sigact));
+#ifdef SA_SIGINFO
    sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP | SA_SIGINFO;
+#else
+   sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP;
+#endif
 
    sigact.sa_sigaction = siginfo;
 #if HAVE_SIGNAL_SIGINFO
@@ -295,7 +299,9 @@ mother_envsetup(argc, argv)
       if (sigaction(ignoresignalv[i], &sigact, NULL) != 0)
          serr("sigaction(%d)", ignoresignalv[i]);
 
+#ifdef SA_SIGINFO
    sigact.sa_flags     = SA_SIGINFO;   /* want to be interrupted. */
+#endif
    sigact.sa_sigaction = sigalrm;
    if (sigaction(SIGALRM, &sigact, NULL) != 0)
       serr("sigaction(SIGALRM)");
diff --git a/sockd/sockd.c b/sockd/sockd.c
index ba02093..67d613a 100755
--- a/sockd/sockd.c
+++ b/sockd/sockd.c
@@ -239,7 +239,11 @@ main(argc, argv)
             newprocinit();
 
             bzero(&sigact, sizeof(sigact));
+#ifdef SA_SIGINFO
             sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP | SA_SIGINFO;
+#else
+            sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP;
+#endif
 
             sigact.sa_sigaction = sighup_child;
             if (sigaction(SIGHUP, &sigact, NULL) != 0) {
diff --git a/sockd/sockd_child.c b/sockd/sockd_child.c
index 1d93a78..877de6d 100644
--- a/sockd/sockd_child.c
+++ b/sockd/sockd_child.c
@@ -1901,7 +1901,11 @@ addchild(type)
           * Next install a SIGHUP handler.  Same for all children and
           * different from the one mother uses.
           */
+#ifdef SA_SIGINFO
          sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP | SA_SIGINFO;
+#else
+         sigact.sa_flags = SA_RESTART | SA_NOCLDSTOP;
+#endif
 
          sigact.sa_sigaction = sighup_child;
          if (sigaction(SIGHUP, &sigact, NULL) != 0)
diff --git a/sockd/sockd_io.c b/sockd/sockd_io.c
index 194cd63..8e6cc0a 100644
--- a/sockd/sockd_io.c
+++ b/sockd/sockd_io.c
@@ -330,7 +330,11 @@ run_io()
 #endif /* DIAGNOSTIC */
 
    bzero(&sigact, sizeof(sigact));
